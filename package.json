{
  "name": "sols-cluster-indicator",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "icons": "powershell.exe -NoProfile -File scripts/build-icons.ps1",
    "desktop": "node node_modules/electron/install.js && vite build && node scripts/run-desktop.js .",
    "test:desktop": "node node_modules/electron/install.js && vite build && node scripts/run-desktop.js scripts/test-desktop.mjs",
    "package:desktop": "vite build && node scripts/package-desktop.js",
    "package:installer": "vite build && node scripts/package-desktop.js --installer",
    "dev": "node src/server/index.js --dev",
    "build": "vite build && node scripts/build-screen-helper.js",
    "prestart": "npm run build",
    "start": "node src/server/index.js",
    "start:authenticated": "powershell.exe -NoProfile -File scripts/start-authenticated.ps1",
    "test": "node --test tests-js/*.test.js && vitest run",
    "test:polling": "node scripts/test-polling.js",
    "package:windows": "npm run build && node scripts/package-windows.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "vite": "^6.3.0",
    "vitest": "^5.0.0"
  }
}
